<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 通知与提醒（D-09 本地通知；合规 §3.2 Android 权限清单） -->
    <!-- 窗口提醒：Android 13+ 运行时权限，拒绝后计时不阻断、App 内横幅引导 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 窗口到点提醒的精确触发；未授权时降级为不精确闹钟（合规 §3.2） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- 设备重启后恢复本地提醒调度（《规格-M2》§6-B14，普通权限无需弹窗） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 提醒震动（安装时权限） -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- 拍照识别（M3）：首次点击「拍照」入口时申请，拒绝降级手动搜索（合规 §3.2） -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- 语音录入（M3 系统 SpeechRecognizer）：首次点击「语音」入口时申请（合规 §3.2） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 相册选图走系统 Photo Picker 主路径，不申请 READ_MEDIA_IMAGES（合规 §3.2〔假设〕） -->
    <!-- 阶段 D：Health Connect 运动数据（D-19 翻案，health 13.3.2 README 对齐；
         仅读取步数/活动能量/体重，数据不出端，首次开启「同步运动数据」时单独同意后申请） -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_WEIGHT"/>
    <!-- health README：步数读取要求声明 Activity Recognition（Health Connect 授权契约内读取，未单独弹窗） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <application
        android:label="EatWise"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic：本地/灰度联调后端为 http（LAN），
             正式上线切 https 后应移除该属性。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect 隐私政策 rationale（health 13.3.2 README：
                 权限页「隐私政策」入口回落到 MainActivity） -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Health Connect 权限使用说明入口（health 13.3.2 README 要求的
             VIEW_PERMISSION_USAGE activity-alias，Google 审核敏感权限需要） -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 断食计时桌面小组件（《规格-M2》§8.2 / 设计规范 §4.5）：
             数据经 home_widget SharedPreferences 共享，Dart 侧 WidgetSyncService
             触发 updateWidget 广播刷新；点击经 home_widget 深链进首页 -->
        <receiver
            android:name=".EatWiseWidgetProvider"
            android:exported="false"
            android:label="@string/eatwise_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/eatwise_widget_info"/>
        </receiver>
        <!-- flutter_local_notifications：重启/换装后恢复已排程的本地通知
             （《规格-M2》§6-B14；App 侧另有首开对账重排兜底） -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 语音录入：检测系统 SpeechRecognizer 服务可用性（API 30+ 包可见性） -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- 应用内更新：url_launcher 外部浏览器打开 APK 下载页（API 30+ 包可见性） -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Health Connect：检测健康应用安装态与 rationale 入口（health 13.3.2 README） -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>

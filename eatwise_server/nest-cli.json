{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "admin/console/index.html", "watchAssets": true },
      { "include": "../public/*.html", "outDir": "dist/public", "watchAssets": true }
    ]
  }
}

# 服务端口
PORT=3000

# PostgreSQL（Prisma）。未配置时服务以「内存数据层」模式运行（接口行为不变，重启丢数据）
DATABASE_URL=postgresql://eatwise:eatwise@localhost:5432/eatwise?schema=public

# 仓储驱动：memory（默认，内存 DataStore）/ prisma（PrismaStore + PostgreSQL，需 DATABASE_URL 且已 migrate）
STORE_DRIVER=memory

# Redis（验证码/会话/热配置/限流）。未配置时相关能力退化到内存实现
REDIS_URL=redis://localhost:6379/0

# JWT（生产必须替换为强随机值；契约 §6.2 建议 ES256 + kid 轮换，骨架阶段 HS256〔假设〕）
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SEC=7200

# 断食达标容差分钟数（D-08，服务端配置热调）
FASTING_TOLERANCE_MINUTES=15

# ===== 图片上传存储（POST/GET /v1/uploads，打卡配图）=====
# 存储驱动：local（默认，落 server 根 uploads/，仅单实例可用，重建即丢）
#           s3（R2/S3 对象存储 + CDN 公开读，多实例/上线必选，见部署手册 §3）
STORAGE_DRIVER=local
# 以下为 STORAGE_DRIVER=s3 时必填，缺一启动即报错（fail fast）：
# 桶名与访问凭据（R2：API Token 的 Access Key ID / Secret Access Key）
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET=
# 区域（R2 用 auto 即可，缺省 auto；AWS S3 填实际区域如 ap-southeast-1）
# S3_REGION=auto
# 自定义端点（R2 必填：https://<account_id>.r2.cloudflarestorage.com；AWS S3 留空走默认）
# S3_ENDPOINT=
# 公开读域名（CDN 或桶公开地址，不带尾斜杠）：上传返回的 url 与 GET 302 目标都拼在它后面
# CDN_BASE_URL=https://cdn.example.com
# 本地存储目录覆盖（默认 server 根 uploads/，一般仅测试隔离用）
# UPLOAD_DIR=

# 应用内更新检查（私有仓库由服务端代理 GitHub Releases，App 不持 token）
# GitHub PAT（repo 只读即可）；不设则匿名请求（私有仓库会 404，自动降级下方静态配置）
GITHUB_RELEASE_TOKEN=
# 降级兜底静态配置（〔假设〕发版后由运维/流水线同步）
APP_LATEST_VERSION=1.0.0
APP_MIN_SUPPORTED_VERSION=1.0.0
APP_APK_URL=
APP_RELEASE_NOTES_ZH=
APP_RELEASE_NOTES_EN=

# ===== 管理端（共享食物候选审核池 /v1/admin/food-candidates + 控制台 /admin）=====
# 管理员账号体系（与用户体系完全独立）：启动时若管理员表为空且以下两项齐备，
# 自动创建 admin 角色种子账号（密码 bcrypt 存储）；都不配置则不创建任何账号
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# 管理员 JWT 独立 secret（缺省由 JWT_SECRET 派生〔假设〕，生产建议显式配置强随机值）
# ADMIN_JWT_SECRET=
# 〔过渡方案〕x-admin-token 兜底：配置后 header x-admin-token 匹配即可访问全部管理端点
#（视为 admin 角色）；账号体系就绪后建议移除本值。未配置且无管理员账号时管理端一律 404
ADMIN_TOKEN=

# 服务端口
PORT=3000

# PostgreSQL（Prisma）。未配置时服务以「内存数据层」模式运行（接口行为不变，重启丢数据）
DATABASE_URL=postgresql://eatwise:eatwise@localhost:5432/eatwise?schema=public

# 仓储驱动：memory（默认，内存 DataStore）/ prisma（PrismaStore + PostgreSQL，需 DATABASE_URL 且已 migrate）
STORE_DRIVER=memory

# Redis（验证码/会话/热配置/限流）。未配置时相关能力退化到内存实现
REDIS_URL=redis://localhost:6379/0

# JWT（生产必须替换为强随机值；契约 §6.2 建议 ES256 + kid 轮换，骨架阶段 HS256〔假设〕）
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SEC=7200

# 断食达标容差分钟数（D-08，服务端配置热调）
FASTING_TOLERANCE_MINUTES=15

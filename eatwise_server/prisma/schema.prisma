// EatWise 数据模型 —— 对齐《后端API契约 v1.0》§二 与 PRD 第五章 8 实体
// 同步字段约定（D-20）：clientRequestId 幂等唯一约束、version/updatedAt（LWW 仲裁）、
// 软删 deletedAt（tombstone）。所有时间戳 UTC 存储（D-07）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  phone               String?   @unique // E.164
  username            String?   @unique // 账号密码登录用户名（D-13 修订：账号密码为主路径）；小写归一化存储
  passwordHash        String?   // bcrypt（bcryptjs），永不明文存储
  wechatOpenId        String?   @unique
  appleSub            String?   @unique
  nickname            String?
  avatarUrl           String?
  gender              String? // male / female
  birthYear           Int?
  heightCm            Float?
  weightKg            Float?
  activityLevel       String? // sedentary / light / moderate / high
  goal                String? // fat_loss / health_metric / routine / trial
  targetWeightKg      Float? // 阶段 B 减重目标：目标体重（kg，25–300；仅 fat_loss 生效）
  targetDate          DateTime? // 阶段 B 减重目标：目标日期（只存日期，UTC 零点；须未来且 ≤2 年）
  locale              String    @default("zh-CN") // D-15
  timezone            String    @default("Asia/Shanghai") // IANA，D-07
  themePref           String    @default("system")
  accessibilityPrefs  Json?
  onboardingStatus    String    @default("none") // none / skipped / completed
  exportStatus        String?
  deletionStatus      String? // null / pending（D-18，7 天冷静期〔假设〕）
  scheduledDeletionAt DateTime? // deletionStatus=pending 时的冷静期截止时刻，到期硬删/匿名化（合规 §4.3）
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  fastingPlans    FastingPlan[]
  fastingRecords  FastingRecord[]
  foodEntries     FoodEntry[]
  dailyNutrition  DailyNutrition[]
  streak          Streak?
  posts           Post[]
  idempotencyKeys IdempotencyKey[]
  refreshTokens   RefreshToken[]

  waterLogs      WaterLog[]
  weightLogs     WeightLog[]
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique // 不透明随机串哈希，滑动轮换 + Reuse Detection（§1.2）
  deviceId   String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model FastingPlan {
  id                String    @id @default(uuid())
  userId            String
  planType          String // 14:10 / 16:8 / 18:6（5:2 仅展示不入库，D-03）
  eatingWindowStart String // 本地时刻 HH:mm，配合 User.timezone 解释
  eatingWindowEnd   String
  effectiveDate     String // 生效本地日 YYYY-MM-DD，次日 0 点生效（D-06）
  status            String // current / pending / expired；同 userId 仅一条 current
  clientRequestId   String?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, clientRequestId])
  @@index([userId, status])
  @@map("fasting_plans")
}

model FastingRecord {
  id              String    @id @default(uuid())
  userId          String
  attributionDate String // 归属本地日 = 进食窗口所属自然日，服务端算（D-07）
  plannedStartAt  DateTime
  plannedEndAt    DateTime // 含延长后移（D-10）
  actualStartAt   DateTime?
  actualEndAt     DateTime?
  extendedMinutes Int       @default(0) // 累计 ≤240（D-10）
  fastedMinutes   Int?
  result          String    @default("on_track") // on_track / completed / ended_early / broken / makeup
  isQualified     Boolean   @default(false) // 达标判定服务端执行（D-08，容差热调）
  eventLog        Json? // 状态变更日志 append-only
  clientRequestId String?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, clientRequestId])
  @@index([userId, attributionDate])
  @@map("fasting_records")
}

model FoodEntry {
  id                String    @id @default(uuid())
  userId            String
  clientRequestId   String // 幂等键 = userId + clientRequestId（D-20）
  eatenAt           DateTime
  foodId            String
  grams             Float
  inputMethod       String // photo / voice / frequent / manual
  photoUrl          String?
  nutritionSnapshot Json // {kcal, proteinG, carbsG, fatG} 服务端按份量换算快照
  version           Int       @default(1) // etag / LWW 版本号
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt // LWW 仲裁基准，数据库时钟赋值
  deletedAt         DateTime? // 软删 tombstone，保留 90 天〔假设〕

  user User @relation(fields: [userId], references: [id])
  food Food @relation(fields: [foodId], references: [id])

  @@unique([userId, clientRequestId])
  @@index([userId, updatedAt, id]) // syncToken 增量下游标
  @@map("food_entries")
}

model Food {
  id              String   @id @default(uuid())
  nameZh          String // 双语食物字段（D-15/D-16）
  nameEn          String
  aliases         String[] // 中英混合别名
  kcalPer100g     Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  category        String?
  source          String? // cn_fct / usda / manual / llm-estimate / community（审核晋升的共享食物）
  isCustom        Boolean  @default(false) // 用户自定义食物（个人库，参与 K1 搜索排内置之后）
  createdByUserId String? // 自定义/社区共享食物创建者（共享食物保留溯源；可见性按 isCustom 过滤）
  clientRequestId String? // 自定义食物创建幂等键（K2，D-20）
  barcode         String? // 包装食品条码（8-14 位数字；条码众包候选 approve 晋升时写入，后续扫码先命中自有库）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries FoodEntry[]

  @@index([barcode]) // 条码命中查询
  @@map("foods")
}

// 共享食物候选审核池（食物库扩充第三层：用户自定义食物经审核晋升为共享库，先审后发 D-17）
model FoodCandidate {
  id              String   @id @default(uuid())
  foodId          String // 被贡献的自定义食物 id（approve 后该食物 isCustom=false 转共享，id 不变）
  userId          String // 贡献者（= 自定义食物创建者）
  status          String   @default("pending") // pending / approved / rejected
  reason          String? // 审核拒绝原因
  kind            String   @default("custom") // custom（自定义食物贡献）/ barcode（条码商品补录贡献）/ correction（已有食物数据纠错）
  barcode         String? // kind=barcode 时必填（8-14 位数字）
  evidenceImageUrl String? // kind=barcode 时必填：包装营养表佐证照片（/v1/uploads/xxx 或 CDN URL），审核「对答案」依据
  suggestion      Json? // kind=correction 时非空：纠错建议值 {nameZh?, nameEn?, per100g}，审核台与原值对照，approve 后应用
  clientRequestId String // 贡献幂等键
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt]) // 审核队列按状态过滤 + 先入先审
  @@index([barcode]) // 同条码重复贡献查重
  @@map("food_candidates")
}

model DailyNutrition {
  id        String   @id @default(uuid())
  userId    String
  date      String // 本地日 YYYY-MM-DD
  kcal      Float    @default(0)
  proteinG  Float    @default(0)
  carbsG    Float    @default(0)
  fatG      Float    @default(0)
  targets   Json? // 当日目标快照（D-04）
  signals   Json? // 四营养素信号灯（D-05）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("daily_nutrition")
}

model Streak {
  id                String   @id @default(uuid())
  userId            String   @unique
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastQualifiedDate String?
  milestones        Json? // {3: achievedAt, 7: ..., 30: ...}
  makeupCards       Json? // {stock, month, usedDates[]}（D-12：月初 2 张/上限 2/仅 7 天内/月底清零）
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("streaks")
}

model Post {
  id               String    @id @default(uuid())
  // 可空：U5 账号删除物理删用户行时，帖子按合规口径匿名化留存（userId 置空）。
  userId           String?
  clientRequestId  String?
  text             String
  imageUrls        String[]
  streakDaysAtPost Int?
  likeCount        Int       @default(0)
  auditStatus      String    @default("pending") // pending / approved / rejected（先审后发 D-17）
  auditReason      Json? // 双语 {zh, en}
  reportCount      Int       @default(0) // 累计被举报次数（去重按 postId+userId）
  reportedAt       DateTime? // 最近一次被举报时间
  visibility       String    @default("public") // self / followers / public 预留
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user User? @relation(fields: [userId], references: [id])

  likes             PostLike[]
  reports           PostReport[]
  moderationEntries ModerationQueue[]

  @@unique([userId, clientRequestId])
  @@index([auditStatus, createdAt])
  @@map("posts")
}

// 点赞幂等记录（契约 §四：postId+userId 唯一约束；C5/C6 点赞计数与 likedByMe 依据）
model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

// 举报幂等记录（同用户同帖一次：reason + createdAt；举报即下架复核依据）
model PostReport {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_reports")
}

// 人工审核队列（机审异常/疑似 与 举报复核共用，D-17 转人工；seq 保入队顺序）
model ModerationQueue {
  seq       Int      @id @default(autoincrement())
  postId    String
  source    String // auto / report
  reason    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("moderation_queue")
}

// 饮水记录（PRD M3 功能点 4）：轻量两态同步（pending/synced），无 update op——
// 逐条 create + delete tombstone 即覆盖全部场景（D-20 幂等：userId + clientRequestId）
model WaterLog {
  id              String    @id @default(uuid())
  userId          String
  clientRequestId String
  amountMl        Int
  loggedAt        DateTime // 饮水时间（UTC）
  localDate       String // 客户端归属日 YYYY-MM-DD（D-07 口径透传）
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // 软删 tombstone

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, clientRequestId])
  @@index([userId, updatedAt, id]) // syncToken 增量下游标
  @@map("water_logs")
}

// 体重记录（阶段 C 体重管理闭环）：同日覆写（userId+date 应用层 upsert），
// clientRequestId 幂等（D-20），体脂率可空，软删 tombstone
model WeightLog {
  id              String    @id @default(uuid())
  userId          String
  clientRequestId String
  date            String // 归属日 YYYY-MM-DD（客户端本地口径透传，D-07）
  weightKg        Float
  bodyFatPct      Float? // 体脂率（%，可空）
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // 软删 tombstone

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, clientRequestId])
  @@index([userId, date]) // 区间查询（GET /weight-logs?from&to）
  @@map("weight_logs")
}

// 幂等表（D-20）：相同 (userId, clientRequestId) 重放返回首次结果，保留 90 天〔假设〕
model IdempotencyKey {
  id              String   @id @default(uuid())
  userId          String
  clientRequestId String
  endpoint        String
  payloadHash     String // 同键不同体 → 409 IDEMPOTENCY_PAYLOAD_MISMATCH
  responseBody    Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, clientRequestId, endpoint])
  @@map("idempotency_keys")
}

// 管理员账号（管理控制台登录体系，与用户体系完全独立；role: admin / reviewer）
model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String // bcrypt（bcryptjs），永不明文存储
  role         String   @default("reviewer") // admin / reviewer
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

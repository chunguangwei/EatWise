# 端口方案：只监听 8443，不占用 80/443（留给主机上其他服务，也绕开部分机房对 80/443 的封锁）。
# 证书方案：自签名证书（50 年有效，至 2076-09-05，SAN=DNS:wcg.polin.tech）+ 客户端证书锁定（pinning）。
#   - cert.pem 可提交 git；key.pem 是私钥，禁止入库（已 gitignore），随部署包手工上传到主机。
#   - App 内置 pinning 只认这张证书；浏览器访问管理控制台需手动确认信任（自签名无 CA 链）。
#   - 证书挂载自 ./deploy/certs（compose 只读卷），到期换证需同步发新版 App 更新 pinning。
wcg.polin.tech:8443 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	# APK 自托管目录（GitHub 私有仓 release asset 匿名 404，安卓更新下载必须走自己）。
	# 宿主机 ./downloads 只读挂到 /srv/downloads（compose），发版时 scp APK 进去。
	# handle 块互斥：/downloads/* 命中即静态直出，不再走下方反代；
	# 其余路径（/v1/*、/admin 等）落入默认 handle，行为不变。
	handle /downloads/* {
		root * /srv/downloads
		file_server
	}

	handle {
		reverse_proxy server:3000
	}

	# 上传图片 ≤5MB（与服务端 MAX_UPLOAD_BYTES 对齐），超限直接 413。
	request_body {
		max_size 8MB
	}
}

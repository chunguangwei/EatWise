# ===== 云主机生产环境变量（复制为 .env.prod 后逐项填写；.env.prod 勿提交）=====
# 端口方案：Caddy 只监听 8443（不占 80/443）；证书为自签名（deploy/certs/，50 年期）+ 客户端 pinning，无需任何 CA/DNS API 凭证。

# --- 数据库（compose 内网地址，主机名勿改；密码自定强随机）---
PG_PASSWORD=换成强随机密码
DATABASE_URL=postgresql://eatwise:与PG_PASSWORD一致@postgres:5432/eatwise?schema=public

# --- 运行模式 ---
NODE_ENV=production
STORE_DRIVER=prisma
PORT=3000

# --- 鉴权（必填，openssl rand -base64 48 各生成一个；生产缺省启动会 fail fast）---
JWT_SECRET=
ADMIN_JWT_SECRET=
JWT_ACCESS_TTL_SEC=7200

# --- 管理员种子账号（启动自动建号，建后可在控制台改密）---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- App 版本与更新检查 ---
GITHUB_RELEASE_TOKEN=
APP_LATEST_VERSION=1.8.2
APP_MIN_SUPPORTED_VERSION=1.0.0
# APK 自托管地址，如 https://wcg.polin.tech:8443/downloads/eatwise-vX.Y.Z.apk。
# 发版时 scp APK 到主机 downloads/ 并更新此值（GitHub 源成功时版本号/说明仍取
# GitHub，仅覆盖下载地址——私有仓 release asset 匿名 404，客户端拿不到 APK）。
APP_APK_URL=

# --- 图片上传（默认 local 落 uploads/ 卷；迁 R2/S3 时改 s3 并补下方变量）---
STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET=
# CDN_BASE_URL=

# --- 断食容差（D-08，热调，分钟）---
FASTING_TOLERANCE_MINUTES=15

# ⚠️ 不要配置 ADMIN_TOKEN——x-admin-token 是过渡兜底后门，生产必须留空。
